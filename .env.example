RISKLENS_DATABASE_URL=sqlite:///./data/risklens.sqlite3
RISKLENS_MODEL_PATH=./artifacts/risk_model.joblib
RISKLENS_MODEL_SHA256=
RISKLENS_DEMO_SEED=41
RISKLENS_RATE_LIMIT_PER_MINUTE=120
# Public demos should keep per-browser SQLite data and simulator state isolated.
RISKLENS_SESSION_ISOLATION=true
RISKLENS_SESSION_SECRET=
RISKLENS_SESSION_COOKIE_SECURE=false
RISKLENS_MAX_DEMO_SESSIONS=500
# Enable only with a Razorpay Test Mode webhook secret. Never put secrets in browser code.
RISKLENS_RAZORPAY_MODE=disabled
RISKLENS_RAZORPAY_TEST_WEBHOOK_SECRET=
RISKLENS_RAZORPAY_TEST_READ_TOKEN=
# Optional, opt-in natural-language synthesis; keep disabled for the offline demo.
RISKLENS_LLM_BASE_URL=
RISKLENS_LLM_API_KEY=
RISKLENS_LLM_MODEL=
RISKLENS_ALLOW_SYNTHETIC_LLM=false
