{
  "mcpServers": {
    "risklens-ai": {
      "command": "/absolute/path/to/RiskLens-AI/.venv/bin/python",
      "args": ["-m", "app.mcp_server"],
      "cwd": "/absolute/path/to/RiskLens-AI",
      "env": {
        "RISKLENS_DATABASE_URL": "sqlite:///./data/risklens.sqlite3",
        "RISKLENS_MODEL_PATH": "./artifacts/risk_model.joblib"
      }
    }
  }
}
